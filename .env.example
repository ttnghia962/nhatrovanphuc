# Sao chép file này thành .env rồi điền giá trị thật:  cp .env.example .env
# File .env không được commit (đã nằm trong .gitignore).

# Cơ sở dữ liệu SQLite. Đường dẫn tính từ thư mục prisma/.
DATABASE_URL="file:./dev.db"

# Khoá ký cookie phiên đăng nhập. BẮT BUỘC phải có, nếu thiếu thì MỌI trang
# (kể cả /login) sẽ lỗi "Thiếu biến môi trường SESSION_SECRET" và không có
# đường quay lại. Sinh một chuỗi ngẫu nhiên dài:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Đổi giá trị này sẽ làm mọi người đang đăng nhập bị đăng xuất.
SESSION_SECRET="thay-bang-chuoi-ngau-nhien-that-dai"

# Mã PIN quản lý ban đầu, ĐÚNG 8 CHỮ SỐ. Dùng khi seed DB lần đầu và cho lệnh
# `npm run admin:pin:reset` (đặt lại PIN khi quên). Không ghi PIN thật vào code
# hay file này vì repo công khai. Admin đổi PIN trên web xong thì giá trị này
# không còn tác dụng cho tới khi chạy lại admin:pin:reset.
ADMIN_INITIAL_PIN="12345678"

# Chỉ dùng khi chạy bằng Docker (docker-compose.yml): tên miền để Caddy xin
# chứng chỉ HTTPS. Thử trên máy cá nhân thì đặt DOMAIN="localhost".
DOMAIN="nhatro.example.com"

# QUAN TRỌNG — múi giờ của tiến trình Node.
# Hạn nhập chỉ số nước (00:00 ngày 10 tháng kế tiếp) được tính theo GIỜ ĐỊA
# PHƯƠNG của máy chủ. Nếu máy chủ chạy UTC thì hạn lệch 7 tiếng và khách thuê
# bị khoá từ 17:00 ngày 9. Luôn đặt TZ=Asia/Ho_Chi_Minh.
TZ="Asia/Ho_Chi_Minh"
